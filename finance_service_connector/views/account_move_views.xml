<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- GoBD tab on customer invoices: retention, legal hold, archive, audit log -->
    <record id="view_move_form_inherit_fsc_gobd" model="ir.ui.view">
        <field name="name">account.move.form.inherit.fsc.gobd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_fsc_archive_now" type="object" string="Archive documents"
                        invisible="fsc_archive_state != 'pending' or state != 'posted'"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="GoBD" name="fsc_gobd_tab"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Issue">
                            <field name="fsc_is_gobd_document" invisible="1"/>
                            <field name="fsc_issued_at"/>
                            <field name="fsc_issued_by_id"/>
                            <field name="fsc_archive_state"/>
                        </group>
                        <group string="Retention (§14b UStG / §147 AO)">
                            <field name="fsc_retention_class"/>
                            <field name="fsc_retention_extra_years"/>
                            <field name="fsc_retention_until"/>
                            <field name="fsc_legal_hold"/>
                            <field name="fsc_legal_hold_until" invisible="not fsc_legal_hold"/>
                            <field name="fsc_legal_hold_reason" invisible="not fsc_legal_hold"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 mb-3" invisible="not fsc_issued_at">
                        <button name="action_fsc_open_legal_hold" type="object" string="Legal hold / retention"
                                class="btn-secondary" icon="fa-lock" groups="account.group_account_manager"/>
                        <button name="action_fsc_verify_integrity" type="object" string="Verify integrity"
                                class="btn-secondary" icon="fa-check-circle"/>
                    </div>
                    <separator string="Archived documents"/>
                    <field name="fsc_archive_ids" readonly="1" nolabel="1">
                        <tree create="0" delete="0">
                            <field name="filename"/>
                            <field name="standard"/>
                            <field name="file_size"/>
                            <field name="sha256" optional="show"/>
                            <field name="archived_at"/>
                            <field name="last_check_at" optional="show"/>
                            <field name="last_check_ok" widget="boolean"
                                   decoration-danger="not last_check_ok"/>
                            <button name="action_download" type="object" icon="fa-download" title="Download"/>
                        </tree>
                    </field>
                    <separator string="Audit log"/>
                    <field name="fsc_audit_event_ids" readonly="1" nolabel="1">
                        <tree create="0" delete="0" decoration-danger="event_type in ('integrity_failed', 'archive_failed')"
                              decoration-muted="event_type in ('reset_blocked', 'hard_delete_blocked')">
                            <field name="event_at"/>
                            <field name="event_type"/>
                            <field name="user_id"/>
                            <field name="reason"/>
                            <field name="new_value" optional="hide"/>
                            <field name="hash" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- GoBD archive column in the invoice list -->
    <record id="view_out_invoice_tree_inherit_fsc_gobd" model="ir.ui.view">
        <field name="name">account.move.list.inherit.fsc.gobd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_residual_signed']" position="after">
                <field name="fsc_archive_state" string="GoBD" optional="show"
                       decoration-success="fsc_archive_state == 'archived'"
                       decoration-warning="fsc_archive_state == 'pending'"
                       decoration-danger="fsc_archive_state == 'failed'"/>
                <field name="fsc_retention_until" optional="hide"/>
                <field name="fsc_legal_hold" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Legal note on taxes -->
    <record id="view_tax_form_inherit_fsc" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.fsc</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ubl_cii_tax_exemption_reason_code']" position="after">
                <field name="fsc_legal_note"
                       invisible="ubl_cii_tax_category_code not in ('E', 'AE', 'K', 'G')"
                       placeholder="e.g. Steuerfreie innergemeinschaftliche Lieferung (§ 4 Nr. 1b UStG)"/>
            </xpath>
        </field>
    </record>
</odoo>
