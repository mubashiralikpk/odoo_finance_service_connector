<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_finance_service" model="ir.ui.view">
            <field name="name">account.move.form.inherit.finance.service</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Sync button after Confirm button -->
                <xpath expr="//button[@name='action_post']" position="after">
                    <button name="action_sync_to_finance_service"
                            type="object"
                            string="Sync to Finance Service"
                            class="btn-secondary"
                            invisible="move_type not in ['out_invoice', 'out_refund']"
                            confirm="Push this invoice to Finance Service?"/>
                </xpath>

                <!-- Finance Service tab appended to notebook -->
                <xpath expr="//notebook" position="inside">
                    <page string="Finance Service"
                          name="finance_service_tab"
                          invisible="move_type not in ['out_invoice', 'out_refund']">
                        <group>
                            <group string="Sync Status">
                                <field name="fs_sync_state" string="Status"/>
                                <field name="fs_synced_at" string="Last Synced" readonly="1"/>
                            </group>
                            <group string="Finance Service Reference">
                                <field name="fs_invoice_id" string="Invoice ID" readonly="1"/>
                                <field name="fs_invoice_number" string="Invoice Number" readonly="1"/>
                            </group>
                        </group>
                        <group invisible="fs_sync_state != 'error'">
                            <field name="fs_sync_error" string="Error Detail" readonly="1"
                                   widget="text" nolabel="1"/>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

        <!-- Sync column in invoice list -->
        <record id="view_out_invoice_tree_inherit_finance_service" model="ir.ui.view">
            <field name="name">account.move.list.inherit.finance.service</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_residual_signed']" position="after">
                    <field name="fs_sync_state" string="FS Sync" optional="show"
                           decoration-success="fs_sync_state == 'synced'"
                           decoration-warning="fs_sync_state == 'not_synced'"
                           decoration-danger="fs_sync_state == 'error'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>