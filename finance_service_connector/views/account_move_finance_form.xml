<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Customer invoice form laid out like the Finance Service admin
        "New / Edit invoice" form. Only applies to customer invoices and
        credit notes; Odoo still computes taxes, totals and numbering.
    -->
    <record id="view_move_form_finance_form" model="ir.ui.view">
        <field name="name">account.move.form.finance.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <!-- ── Banners (top of the sheet) ───────────────────────────── -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 o_fsc_compliance" role="alert"
                     invisible="not fsc_compliance_issues or state != 'draft' or not fsc_is_gobd_document">
                    <strong>Not ready to issue (GoBD / §14 UStG / EN 16931)</strong>
                    <field name="fsc_compliance_issues" nolabel="1" class="d-block mt-1" style="white-space: pre-line;"/>
                </div>
                <div class="alert alert-info mb-0" role="status"
                     invisible="not fsc_issued_at or not fsc_is_gobd_document">
                    Issued and locked (GoBD). To change it: "Cancel invoice" (Stornorechnung + new invoice) or "Credit Note".
                    Archive: <field name="fsc_archive_state" nolabel="1" class="d-inline fw-bold"/> ·
                    retain until <field name="fsc_retention_until" nolabel="1" class="d-inline fw-bold"/>
                    <span invisible="not fsc_legal_hold" class="badge text-bg-danger ms-2">Legal hold</span>
                </div>
            </xpath>
            <!-- Ribbons: one status ribbon from the invoice status instead of Odoo's Paid / Reversed -->
            <xpath expr="//widget[@name='web_ribbon'][contains(@invisible, &quot;payment_state != 'paid'&quot;)]" position="attributes">
                <attribute name="invisible">payment_state != 'paid' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or fsc_is_gobd_document</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][contains(@invisible, &quot;payment_state != 'in_payment'&quot;)]" position="attributes">
                <attribute name="invisible">payment_state != 'in_payment' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or fsc_is_gobd_document</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][contains(@invisible, &quot;payment_state != 'partial'&quot;)]" position="attributes">
                <attribute name="invisible">payment_state != 'partial' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or fsc_is_gobd_document</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][contains(@invisible, &quot;payment_state != 'reversed'&quot;)]" position="attributes">
                <attribute name="invisible">payment_state != 'reversed' or fsc_is_gobd_document</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][contains(@invisible, &quot;payment_state != 'reversed'&quot;)]" position="after">
                <widget name="web_ribbon" title="Paid" bg_color="text-bg-success"
                        invisible="not fsc_is_gobd_document or fsc_status != 'paid'"/>
                <widget name="web_ribbon" title="Partially paid" bg_color="text-bg-warning"
                        invisible="not fsc_is_gobd_document or fsc_status != 'partial'"/>
                <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                        invisible="not fsc_is_gobd_document or fsc_status != 'overdue'"/>
                <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                        invisible="not fsc_is_gobd_document or fsc_status != 'cancelled'"/>
                <widget name="web_ribbon" title="Cancellation" bg_color="text-bg-secondary"
                        invisible="not fsc_is_gobd_document or fsc_status != 'storno'"/>
            </xpath>

            <!-- status of the invoice (draft, open, sent, partially paid, overdue, paid, cancelled) -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="mb-2" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="fsc_status" widget="badge" nolabel="1"
                           decoration-muted="fsc_status == 'draft'"
                           decoration-info="fsc_status in ('open', 'sent')"
                           decoration-warning="fsc_status == 'partial'"
                           decoration-danger="fsc_status in ('overdue', 'cancelled')"
                           decoration-primary="fsc_status == 'storno'"
                           decoration-success="fsc_status == 'paid'"/>
                    <span invisible="not fsc_cancellation_id" class="ms-2 text-muted">
                        Cancelled by <field name="fsc_cancellation_id" class="d-inline" readonly="1"/>
                    </span>
                    <span invisible="not fsc_replacement_id" class="ms-2 text-muted">
                        · Replaced by <field name="fsc_replacement_id" class="d-inline" readonly="1"/>
                    </span>
                    <span invisible="not fsc_replaces_id" class="ms-2 text-muted">
                        Replaces <field name="fsc_replaces_id" class="d-inline" readonly="1"/> (cancelled)
                    </span>
                </div>
            </xpath>

            <!-- ── Left column: member + address ────────────────────────── -->
            <xpath expr="//group[@id='header_left_group']/label[@for='partner_id'][1]" position="attributes">
                <attribute name="string">Member</attribute>
            </xpath>
            <!-- the address is shown as editable fields below, so don't repeat it under the name -->
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="attributes">
                <attribute name="context">{
                    'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                    'show_address': context.get('default_move_type', 'entry') not in ('out_invoice', 'out_refund'),
                    'show_vat': True}</attribute>
            </xpath>
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="after">
                <field name="fsc_customer_type" widget="badge" readonly="1"
                       decoration-info="fsc_customer_type == 'b2b'" decoration-muted="fsc_customer_type == 'b2c'"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not partner_id"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']/field[@name='partner_shipping_id']" position="before">
                <field name="fs_rcpt_street2" placeholder="Address supplement (optional)"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <field name="fs_rcpt_street" placeholder="Street and house number"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <label for="fs_rcpt_zip" string="Postcode / City"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <div class="d-flex gap-2" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="fs_rcpt_zip" placeholder="Postcode" class="o_fs_zip"
                           readonly="state != 'draft'"/>
                    <field name="fs_rcpt_city" placeholder="City"
                           readonly="state != 'draft'"/>
                </div>
                <field name="fs_rcpt_country_id" placeholder="Country" options="{'no_create': True}"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <field name="fs_rcpt_email" widget="email" placeholder="Email (optional)"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
            </xpath>

            <!-- ── Right column: member no., service date, buyer ref ────── -->
            <xpath expr="//group[@id='header_right_group']/label[@for='invoice_date'][1]" position="before">
                <field name="fs_rcpt_member_number" placeholder="Member number (optional)"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='delivery_date']" position="attributes">
                <attribute name="string">Delivery / service date</attribute>
                <attribute name="invisible">(move_type not in ('out_invoice', 'out_refund') and not show_delivery_date) or (move_type in ('out_invoice', 'out_refund') and fs_service_type == 'none' and state == 'draft')</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/div[hasclass('o_td_label')]" position="before">
                <field name="fs_service_type"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <xpath expr="//group[@id='header_right_group']/field[@name='delivery_date']" position="move"/>
                <field name="fs_service_date_to"
                       invisible="fs_service_type not in ('delivery_period', 'performance_period')"
                       required="state == 'draft' and fs_service_type in ('delivery_period', 'performance_period')"
                       readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/div[@name='due_date']" position="after">
                <field name="fs_buyer_reference" placeholder="Buyer reference / Leitweg-ID (optional)"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <field name="fsc_export_evidence_ref" placeholder="Only for exports (VAT category G)"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
            </xpath>

            <!-- ── Document title + introductory text ───────────────────── -->
            <xpath expr="//sheet/notebook" position="before">
                <group class="o_fs_document" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="fs_document_title" readonly="state != 'draft'"/>
                    <field name="fs_intro_text" placeholder="Introductory text (optional)"
                           readonly="state != 'draft'"/>
                </group>
            </xpath>

            <!-- ── Article lines: Finance column names ──────────────────── -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="string">Article</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                <attribute name="string">Description</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                <attribute name="string">Qty</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id'][1]" position="attributes">
                <attribute name="string">Unit</attribute>
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="string">Net price</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                <attribute name="string">VAT</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="attributes">
                <attribute name="string">Net total</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_total']" position="attributes">
                <attribute name="string">Total</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- ── Closing notes, payment terms, postscript ─────────────── -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='narration']" position="attributes">
                <attribute name="placeholder">Closing notes / footer text (optional)</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']/group[hasclass('oe_invoice_lines_tab')]" position="after">
                <group class="o_fs_closing" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="fs_payment_terms_text"
                           placeholder="Payment terms (optional), e.g. Payable within 14 days without deduction"
                           readonly="state != 'draft'"/>
                    <field name="fs_postscript" placeholder="Postscript (optional)"
                           readonly="state != 'draft'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
