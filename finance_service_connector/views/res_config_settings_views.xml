<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 17: Settings → Invoicing → "GoBD (Germany)" block -->
    <record id="res_config_settings_view_form_finance_service" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fsc.gobd</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="GoBD (Germany)" name="fsc_gobd_setting_container">
                    <setting string="Tax number (Steuernummer)"
                             help="§14 Abs. 4 Nr. 2 UStG: your VAT ID or tax number must be on every invoice. Also written to the e-invoice (BT-32).">
                        <field name="fsc_tax_number" placeholder="e.g. 143/123/45678"/>
                    </setting>
                    <setting string="B2B: require customer VAT ID"
                             help="Business customers (contact type Company) in the EU need a VAT ID before an invoice can be issued. Private customers (Individual, B2C) and businesses outside the EU never need one. Reverse charge and intra-EU supplies always need it.">
                        <field name="fsc_b2b_require_vat"/>
                    </setting>
                    <setting string="Invoice retention"
                             help="Years after the end of the issue year (legal minimum 8, §14b UStG / §147 AO).">
                        <field name="fsc_retention_years"/>
                    </setting>
                    <setting string="Lock issued invoices with hash"
                             help="Odoo's inalterability hash on customer invoice journals + audit trail. Cannot be switched off once entries are hashed.">
                        <field name="fsc_hash_lock_active" readonly="1"/>
                        <div class="mt8" invisible="fsc_hash_lock_active">
                            <button name="action_fsc_enable_hash_lock" type="object" string="Enable"
                                    class="btn-link" icon="fa-lock"/>
                        </div>
                    </setting>
                    <setting string="GoBD export (Z3)" help="ZIP for the tax auditor: CSV + GDPdU index.xml + original PDF/XML + audit log.">
                        <button name="action_fsc_open_gobd_export" type="object" string="Export"
                                class="btn-link" icon="fa-download"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
