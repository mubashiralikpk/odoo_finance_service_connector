<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Odoo 17: Settings → Invoicing → "Finance Service" block -->
        <record id="res_config_settings_view_form_finance_service" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.finance.service</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='account']" position="inside">
                    <block title="Finance Service" name="finance_service_setting_container">
                        <setting string="API URL" help="Base URL of the Finance Service, e.g. http://host.docker.internal:3000">
                            <field name="fs_api_url" placeholder="http://host.docker.internal:3000"/>
                        </setting>
                        <setting string="Tenant ID" help="UUID of this company's Finance Service tenant">
                            <field name="fs_tenant_id" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                        </setting>
                        <setting string="API Key" help="API key from the Finance Service tenant">
                            <field name="fs_api_key" password="True" placeholder="fs_xxxxxxxxxxxx"/>
                        </setting>
                        <setting help="Automatically push invoices to the Finance Service when they are confirmed">
                            <field name="fs_auto_sync"/>
                        </setting>
                        <setting string="Connection" help="Checks the API URL, API key and Tenant ID against the Finance Service backend">
                            <button name="action_fs_test_connection" type="object"
                                    string="Test Connection" icon="fa-plug" class="btn-secondary"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
