<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Recipient address = the invoice snapshot (same data as the e-invoice XML) -->
    <template id="fsc_recipient_address">
        <address class="mb-0">
            <div t-out="o.partner_id.commercial_partner_id.name if o.partner_id.parent_id else o.partner_id.name"/>
            <div t-if="o.partner_id.parent_id" t-out="o.partner_id.name"/>
            <div t-if="o.fs_rcpt_street2" t-out="o.fs_rcpt_street2"/>
            <div t-if="o.fs_rcpt_street" t-out="o.fs_rcpt_street"/>
            <div t-if="o.fs_rcpt_zip or o.fs_rcpt_city">
                <span t-out="o.fs_rcpt_zip"/> <span t-out="o.fs_rcpt_city"/>
            </div>
            <div t-if="o.fs_rcpt_country_id and o.fs_rcpt_country_id != o.company_id.country_id"
                 t-out="o.fs_rcpt_country_id.name"/>
        </address>
    </template>

    <template id="report_invoice_document_fsc" inherit_id="account.report_invoice_document">
        <!-- address blocks -->
        <xpath expr="//div[@name='address_not_same_as_shipping']//address" position="replace">
            <t t-if="o.fsc_is_gobd_document" t-call="finance_service_connector.fsc_recipient_address"/>
            <address t-else="" class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']//address" position="replace">
            <t t-if="o.fsc_is_gobd_document" t-call="finance_service_connector.fsc_recipient_address"/>
            <address t-else="" class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>
        <xpath expr="//div[@name='no_shipping']//address" position="replace">
            <t t-if="o.fsc_is_gobd_document" t-call="finance_service_connector.fsc_recipient_address"/>
            <address t-else="" class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>

        <!-- PAID / CANCELLED stamp in the HTML preview (the PDF gets it as an overlay on a copy) -->
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="fsc_stamp" t-value="report_type == 'html' and o.fsc_is_gobd_document and o._fsc_stamp_kind()"/>
            <div t-if="fsc_stamp in ('paid', 'cancelled')" style="position: relative; height: 0; z-index: 10;">
                <img t-att-src="'/finance_service_connector/static/stamps/%s_stamp_%s.png' % (fsc_stamp, 'de' if (o.partner_id.lang or '').startswith('de') else 'en')"
                     t-att-alt="fsc_stamp"
                     t-attf-style="position: absolute; left: 50%; top: 110px; width: 230px; opacity: 0.55; pointer-events: none; transform: translateX(-50%) rotate(#{'-22deg' if fsc_stamp == 'paid' else '0deg'});"/>
            </div>
        </xpath>

        <!-- the Storno / credit note is reconciled like a payment: do not call it "Paid on" -->
        <xpath expr="//i[hasclass('oe_payment_label')]" position="replace">
            <t t-set="fsc_counterpart" t-value="o.env['account.move'].sudo().browse(payment_vals.get('move_id') or [])"/>
            <i class="oe_form_field text-end oe_payment_label">
                <t t-if="fsc_counterpart and fsc_counterpart in o.reversal_move_id and fsc_counterpart == o.fsc_cancellation_id">Cancelled by <t t-out="fsc_counterpart.name"/> on <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/></t>
                <t t-elif="fsc_counterpart and fsc_counterpart in o.reversal_move_id">Credit note <t t-out="fsc_counterpart.name"/> on <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/></t>
                <t t-else="">Paid on <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/></t>
            </i>
        </xpath>

        <!-- document title -->
        <xpath expr="//div[hasclass('page')]/h2/span[@t-if=&quot;o.move_type == 'out_invoice' and o.state == 'posted'&quot;]" position="replace">
            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'" t-out="o._fsc_document_title()"/>
        </xpath>
        <xpath expr="//div[hasclass('page')]/h2/span[@t-elif=&quot;o.move_type == 'out_refund' and o.state == 'posted'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'" t-out="o._fsc_document_title()"/>
        </xpath>

        <!-- delivery / service date or period (§14 Abs. 4 Nr. 6 UStG) -->
        <!-- the date label of a correction: not "Gutschriftsdatum" (§14 Abs. 4 Nr. 10 UStG) -->
        <xpath expr="//div[@name='invoice_date']//t[@t-elif=&quot;o.move_type == 'out_refund'&quot;]" position="replace">
            <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date:</strong></t>
        </xpath>
        <xpath expr="//div[@name='delivery_date']" position="replace">
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                 t-if="o.delivery_date" name="delivery_date">
                <strong t-if="o.fsc_is_gobd_document" t-out="o._fsc_service_date_label()"/>
                <strong t-else="">Delivery Date</strong>:<br/>
                <span t-field="o.delivery_date">2023-09-25</span>
                <t t-if="o.fs_service_date_to"> – <span t-field="o.fs_service_date_to"/></t>
            </div>
        </xpath>
        <xpath expr="//div[@name='customer_code']" position="replace">
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                 t-if="o.fs_rcpt_member_number or (not o.fsc_is_gobd_document and o.partner_id.ref)" name="customer_code">
                <strong>Member number:</strong><br/>
                <span t-out="o.fs_rcpt_member_number or o.partner_id.ref"/>
            </div>
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                 t-if="o.fs_buyer_reference" name="fsc_buyer_reference">
                <strong>Buyer reference:</strong><br/>
                <span t-out="o.fs_buyer_reference"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="after">
            <!-- seller tax identification (§14 Abs. 4 Nr. 2 UStG) -->
            <div class="row mb-2 small" name="fsc_seller_tax" t-if="o.fsc_is_gobd_document">
                <div class="col-12">
                    <t t-if="o.company_id.vat">VAT ID: <span t-out="o.company_id.vat"/></t>
                    <t t-if="o.company_id.vat and o.company_id.fsc_tax_number"> · </t>
                    <t t-if="o.company_id.fsc_tax_number">Tax number: <span t-out="o.company_id.fsc_tax_number"/></t>
                    <t t-if="o.partner_id.commercial_partner_id.vat"> · Customer VAT ID: <span t-out="o.partner_id.commercial_partner_id.vat"/></t>
                </div>
            </div>
            <p t-if="o.fs_intro_text" class="mb-3" style="white-space: pre-line;" name="fsc_intro" t-out="o.fs_intro_text"/>
        </xpath>

        <!-- payment terms text, legal statements, postscript -->
        <xpath expr="//div[@id='payment_term']" position="inside">
            <p t-if="o.fs_payment_terms_text" class="mb-2" style="white-space: pre-line;" name="fsc_payment_terms"
               t-out="o.fs_payment_terms_text"/>
            <div t-if="o.fsc_legal_statements" class="mb-2 fw-bold" style="white-space: pre-line;" name="fsc_legal_statements"
                 t-out="o.fsc_legal_statements"/>
            <p t-if="o.fs_postscript" class="mb-2" style="white-space: pre-line;" name="fsc_postscript"
               t-out="o.fs_postscript"/>
        </xpath>
    </template>

    <!-- DIN 5008 layout: same snapshot address in the address window -->
    <template id="external_layout_din5008_account_move_fsc" inherit_id="l10n_din5008.external_layout_din5008_account_move">
        <xpath expr="//address" position="replace">
            <t t-if="o.fsc_is_gobd_document" t-call="finance_service_connector.fsc_recipient_address"/>
            <address t-else="" class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>
    </template>
</odoo>
